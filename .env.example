# Credentials only.
#
# Everything else — model, reasoning effort, budget, wall clock — is config,
# with defaults in base/config.ts and per-run overrides on the CLI:
#
#   jam run --model gpt-5.6-luna --effort high

# ── OpenAI ────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Azure OpenAI (alternative) ────────────────────────────────────────
# Set these INSTEAD of OPENAI_API_KEY. The provider is auto-detected, and
# --model is your deployment name.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
